{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production Worker (main-vendor). Staging uses the distinct "-stg" Worker on main-stg-vendor.
  "name": "rj-ravani-front-end",
  "main": "worker/index.ts",
  "compatibility_date": "2025-03-25",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "vars": { "API_ORIGIN": "https://api-ravani.rezolv.app" }
}
