{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Staging-only Worker, deliberately distinct from production's "rj-ravani-admin-front-end"
  // (main-agency, Next.js) so a staging deploy can never overwrite the live Worker.
  "name": "rj-ravani-admin-front-end-stg",
  "main": "worker/index.ts",
  "compatibility_date": "2025-03-25",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "vars": { "API_ORIGIN": "http://api-ravani.fl8.in" }
}
