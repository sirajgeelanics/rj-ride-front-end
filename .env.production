# Production: /vendor/api/* is proxied by the Cloudflare Worker. WebSocket connects directly to
# the API (Worker only handles HTTP /vendor/api/* — it has no WebSocket proxy path).
VITE_API_ORIGIN=
API_ORIGIN=http://api-ravani.fl8.in
NEXT_PUBLIC_WS_ORIGIN=wss://api-ravani.fl8.in
NEXT_PUBLIC_BASE_PATH=/vendor
