# Django backend the Next server proxies /api/* to.
API_ORIGIN=https://api-ravani.rezolv.app
NEXT_PUBLIC_WS_ORIGIN=wss://api-ravani.rezolv.app
# Browser-reachable Traccar URL, embedded as an iframe on the Tracking page's "Traccar" view.
# Leave unset to hide that view entirely.
NEXT_PUBLIC_TRACCAR_URL=
